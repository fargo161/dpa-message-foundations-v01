{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpa-message-foundations.invalid/schemas/semantic-request.schema.json",
  "title": "DPA semantic request contract",
  "allOf": [
    { "$ref": "#/$defs/baseRequest" },
    {
      "oneOf": [
        { "$ref": "#/$defs/dealRequest" },
        { "$ref": "#/$defs/pressureRequest" },
        { "$ref": "#/$defs/askRequest" }
      ]
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:%-]*$"
    },
    "actionIdentifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "nonEmptyObject": {
      "type": "object",
      "minProperties": 1
    },
    "semanticValue": {
      "oneOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "type": "number" },
        { "type": "boolean" },
        { "$ref": "#/$defs/nonEmptyObject" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/semanticValue" } }
      ]
    },
    "quantity": {
      "type": "number",
      "minimum": 0.000001
    },
    "exchangeSlot": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "object": { "$ref": "#/$defs/nonEmptyString" },
        "quantity": { "$ref": "#/$defs/quantity" },
        "unit": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "$ref": "#/$defs/nonEmptyString" },
        "change": { "$ref": "#/$defs/nonEmptyString" },
         "information": { "$ref": "#/$defs/nonEmptyString" }
       },
      "additionalProperties": false
    },
    "requestSlot": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "action": { "$ref": "#/$defs/actionIdentifier" },
        "object": { "$ref": "#/$defs/identifier" },
        "permission": { "$ref": "#/$defs/identifier" },
        "information": { "$ref": "#/$defs/identifier" },
        "request": { "$ref": "#/$defs/identifier" },
        "condition": { "$ref": "#/$defs/semanticValue" },
        "leverage": { "$ref": "#/$defs/semanticValue" }
      },
      "additionalProperties": false
    },
    "pressureSlot": {
      "type": "object",
      "minProperties": 1,
      "properties": {
            "kind": { "$ref": "#/$defs/nonEmptyString" },
            "demandId": { "$ref": "#/$defs/nonEmptyString" },
            "subject": { "$ref": "#/$defs/nonEmptyString" },
            "object": { "$ref": "#/$defs/nonEmptyString" },
            "term": { "$ref": "#/$defs/nonEmptyString" },
            "amount": { "$ref": "#/$defs/quantity" },
            "unit": { "$ref": "#/$defs/nonEmptyString" },
            "due": { "$ref": "#/$defs/nonEmptyString" },
            "sourceAssertionId": { "$ref": "#/$defs/nonEmptyString" },
            "scope": { "$ref": "#/$defs/nonEmptyString" },
            "contextId": { "$ref": "#/$defs/identifier" },
            "validFrom": { "$ref": "#/$defs/nonEmptyString" },
            "validUntil": { "$ref": "#/$defs/nonEmptyString" },
            "pressureContractId": { "$ref": "#/$defs/nonEmptyString" },
            "authoredDemand": { "$ref": "#/$defs/nonEmptyString" },
            "consequenceId": { "$ref": "#/$defs/nonEmptyString" },
            "text": { "$ref": "#/$defs/nonEmptyString" },
            "fearedBy": { "$ref": "#/$defs/nonEmptyString" },
            "fearedConsequenceSourceAssertionId": { "$ref": "#/$defs/nonEmptyString" },
            "leverageBasis": { "$ref": "#/$defs/nonEmptyString" },
            "validity": { "$ref": "#/$defs/pressureValidity" }
      },
      "additionalProperties": false
    },
    "pressureValidity": {
      "type": "object",
      "required": ["scope", "contextId", "validFrom", "validUntilIsUnbounded"],
      "properties": {
        "scope": { "const": "ACTUAL" },
        "contextId": { "$ref": "#/$defs/identifier" },
        "validFrom": { "$ref": "#/$defs/nonEmptyString" },
        "validUntil": { "$ref": "#/$defs/nonEmptyString" },
        "validUntilIsUnbounded": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "slots": {
      "type": "object",
      "required": ["actor", "target", "action", "contextId"],
      "properties": {
        "actor": { "$ref": "#/$defs/nonEmptyString" },
        "target": { "$ref": "#/$defs/nonEmptyString" },
        "action": { "$ref": "#/$defs/actionIdentifier" },
        "leverage": { "$ref": "#/$defs/semanticValue" },
        "offer": { "$ref": "#/$defs/exchangeSlot" },
        "return": { "$ref": "#/$defs/exchangeSlot" },
        "demand": { "$ref": "#/$defs/pressureSlot" },
        "consequence": { "$ref": "#/$defs/pressureSlot" },
        "request": { "$ref": "#/$defs/requestSlot" },
        "contextId": { "$ref": "#/$defs/identifier" },
        "actorId": { "$ref": "#/$defs/identifier" },
        "targetId": { "$ref": "#/$defs/identifier" },
        "actionId": { "$ref": "#/$defs/actionIdentifier" },
        "speechAct": { "enum": ["DEAL", "PRESSURE", "ASK"] },
        "outcome": { "const": "PROPOSED" },
        "OFFER": { "$ref": "#/$defs/exchangeSlot" },
        "RETURN": { "$ref": "#/$defs/exchangeSlot" },
        "DEMAND": { "$ref": "#/$defs/pressureSlot" },
        "CONSEQUENCE": { "$ref": "#/$defs/pressureSlot" },
        "REQUEST": { "$ref": "#/$defs/requestSlot" }
      },
      "additionalProperties": false
    },
    "provenanceEntry": {
      "type": "object",
      "required": ["sourceId", "sourceRecordId", "transformVersion", "licenseId"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/nonEmptyString" },
        "sourceRecordId": { "$ref": "#/$defs/nonEmptyString" },
        "transformVersion": { "$ref": "#/$defs/nonEmptyString" },
        "licenseId": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "semanticBinding": {
      "type": "object",
      "required": ["bindingVersion", "source", "sourceRecordId", "actionId", "actorId", "targetId", "contextId", "payload", "semanticSlots"],
      "properties": {
        "bindingVersion": { "const": "mechanics-tpl-binding@0.1" },
        "source": { "enum": ["MECHANICS_RESOLUTION", "AUTHORED_SEMANTIC_CONTRACT"] },
        "sourceRecordId": { "$ref": "#/$defs/nonEmptyString" },
        "actionId": { "$ref": "#/$defs/actionIdentifier" },
        "actorId": { "$ref": "#/$defs/identifier" },
        "targetId": { "$ref": "#/$defs/identifier" },
        "contextId": { "$ref": "#/$defs/identifier" },
        "payload": { "$ref": "#/$defs/nonEmptyObject" },
        "semanticSlots": { "$ref": "#/$defs/nonEmptyObject" }
      },
      "additionalProperties": false
    },
    "baseRequest": {
      "type": "object",
      "required": [
        "schemaVersion", "adapterVersion", "semanticRequestId", "actionId", "actorId", "targetId", "contextId",
        "actor", "target", "action", "speechAct", "outcome", "slots", "mandatorySemanticFacts",
        "forbiddenSemanticAdditions", "provenance", "semanticBinding"
      ],
      "properties": {
        "schemaVersion": { "const": "dpa-keyword-foundation@0.1" },
        "adapterVersion": { "const": "action-tpl-adapter@0.1" },
        "semanticRequestId": { "$ref": "#/$defs/identifier" },
        "actionId": { "$ref": "#/$defs/actionIdentifier" },
        "actorId": { "$ref": "#/$defs/identifier" },
        "targetId": { "$ref": "#/$defs/identifier" },
        "contextId": { "$ref": "#/$defs/identifier" },
        "actor": { "$ref": "#/$defs/nonEmptyString" },
        "target": { "$ref": "#/$defs/nonEmptyString" },
        "action": { "$ref": "#/$defs/actionIdentifier" },
        "speechAct": { "enum": ["DEAL", "PRESSURE", "ASK"] },
        "outcome": { "const": "PROPOSED" },
        "slots": { "$ref": "#/$defs/slots" },
        "mandatorySemanticFacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "forbiddenSemanticAdditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provenanceEntry" }
        },
        "semanticBinding": { "$ref": "#/$defs/semanticBinding" }
      },
      "additionalProperties": false
    },
    "dealRequest": {
      "type": "object",
      "properties": {
        "speechAct": { "const": "DEAL" },
        "actionId": { "enum": ["OFFER_PARTIAL_PAYMENT", "OFFER_CASH_FOR_EXTENSION", "TRADE_INFORMATION"] },
        "slots": {
          "allOf": [
            { "$ref": "#/$defs/slots" },
            {
              "type": "object",
              "required": ["OFFER", "RETURN", "offer", "return"],
              "properties": {
                "OFFER": { "$ref": "#/$defs/exchangeSlot" },
                "RETURN": { "$ref": "#/$defs/exchangeSlot" },
                "offer": { "$ref": "#/$defs/exchangeSlot" },
                "return": { "$ref": "#/$defs/exchangeSlot" }
              }
            }
          ]
        }
      }
    },
    "pressureRequest": {
      "type": "object",
      "properties": {
        "speechAct": { "const": "PRESSURE" },
        "actionId": { "const": "INVOKE_CONSEQUENCE" },
        "slots": {
          "allOf": [
            { "$ref": "#/$defs/slots" },
            {
              "type": "object",
              "required": ["DEMAND", "CONSEQUENCE", "demand", "consequence"],
              "properties": {
                "DEMAND": { "$ref": "#/$defs/pressureSlot" },
                "CONSEQUENCE": { "$ref": "#/$defs/pressureSlot" },
                "demand": { "$ref": "#/$defs/pressureSlot" },
                "consequence": { "$ref": "#/$defs/pressureSlot" }
              }
            }
          ]
        }
      }
    },
    "askRequest": {
      "type": "object",
      "properties": {
        "speechAct": { "const": "ASK" },
        "actionId": { "enum": ["REQUEST_EXTENSION", "REQUEST_ACCESS", "CHALLENGE_DEBT_VALIDITY", "REQUEST_EVIDENCE", "REQUEST_SUPPORT"] },
        "slots": {
          "allOf": [
            { "$ref": "#/$defs/slots" },
            {
              "type": "object",
              "required": ["REQUEST", "request"],
              "properties": {
                "REQUEST": { "$ref": "#/$defs/requestSlot" },
                "request": { "$ref": "#/$defs/requestSlot" }
              }
            }
          ]
        }
      }
    }
  }
}
