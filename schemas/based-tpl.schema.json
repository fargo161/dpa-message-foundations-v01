{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpa-message-foundations.invalid/schemas/based-tpl.schema.json",
  "title": "DPA BASED and TPL foundation artifacts",
  "type": "object",
  "required": ["schemaVersion", "cues", "vibes", "speechActs", "deliveryIntensities", "matrix", "tplFamilies", "atoms", "constructions", "protocols", "templates", "styleProfiles", "semanticInvarianceBoundary", "fallbackPolicy"],
  "properties": {
    "schemaVersion": { "const": "dpa-keyword-foundation@0.1" },
    "cues": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/cue" } },
    "vibes": { "type": "array", "minItems": 20, "maxItems": 20, "items": { "$ref": "#/$defs/vibe" } },
    "speechActs": { "const": ["DEAL", "PRESSURE", "ASK"] },
    "deliveryIntensities": { "const": ["SUBTLE", "BALANCED", "OVERT"] },
    "matrix": { "type": "array", "minItems": 180, "maxItems": 180, "items": { "$ref": "#/$defs/matrixCell" } },
    "tplFamilies": { "const": ["VOICE_QUALITY", "VOCALIZATION", "TACTILE_KINESIC", "VISUAL_KINESIC", "ARTIFACT"] },
    "atoms": { "type": "array", "items": { "$ref": "#/$defs/atom" } },
    "constructions": { "type": "array", "items": { "$ref": "#/$defs/construction" } },
    "protocols": { "type": "array", "items": { "$ref": "#/$defs/protocol" } },
    "templates": { "type": "array", "minItems": 180, "maxItems": 180, "items": { "$ref": "#/$defs/template" } },
    "styleProfiles": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/styleProfile" } },
    "semanticInvarianceBoundary": { "$ref": "#/$defs/faceBoundary" },
    "fallbackPolicy": { "$ref": "#/$defs/fallbackPolicy" }
  },
  "additionalProperties": false,
  "$defs": {
    "cue": {
      "type": "object",
      "required": ["cueId", "name", "governingForce"],
      "properties": {
        "cueId": { "enum": ["B", "A", "S", "E", "D"] },
        "name": { "type": "string", "minLength": 1 },
        "governingForce": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "vibe": {
      "type": "object",
      "required": ["vibeId", "name", "primaryCue", "secondaryCue", "fusionLogic", "provenance"],
      "properties": {
        "vibeId": { "pattern": "^[A-Z][A-Z]$" },
        "name": { "type": "string", "minLength": 1 },
        "primaryCue": { "enum": ["B", "A", "S", "E", "D"] },
        "secondaryCue": { "enum": ["B", "A", "S", "E", "D"] },
        "fusionLogic": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "object",
          "required": ["source", "status"],
          "properties": { "source": { "type": "string", "minLength": 1 }, "status": { "const": "PROJECT_AUTHORED" } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "matrixCell": {
      "type": "object",
      "required": ["key", "vibeId", "speechAct", "deliveryIntensity", "actionInvariant", "candidateAnchorIds", "universalFallbackId", "allowedProtocolIds", "preferredProtocolIds", "excludedProtocolIds", "requiredContextOrLoreFacts", "forbiddenSemanticAdditions", "reviewStatus", "readiness", "provenance", "templateVariantId", "constructionId", "tplProtocolId", "styleProfileId", "executionMode", "gateDisposition", "previewEligible", "productionEligible", "sourceLine"],
      "properties": {
        "key": { "pattern": "^(DEAL|PRESSURE|ASK)_[A-Z]{2}_(SUBTLE|BALANCED|OVERT)$" },
        "vibeId": { "pattern": "^[A-Z][A-Z]$" },
        "speechAct": { "enum": ["DEAL", "PRESSURE", "ASK"] },
        "deliveryIntensity": { "enum": ["SUBTLE", "BALANCED", "OVERT"] },
        "actionInvariant": {
          "oneOf": [
            { "const": ["OFFER", "RETURN"] },
            { "const": ["DEMAND", "CONSEQUENCE"] },
            { "const": ["REQUEST"] }
          ]
        },
        "candidateAnchorIds": { "type": "array", "items": { "pattern": "^ANCHOR_(DEAL|PRESSURE|ASK)_[A-Z]{2}$" } },
        "universalFallbackId": { "type": ["string", "null"] },
        "allowedProtocolIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "preferredProtocolIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "excludedProtocolIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "requiredContextOrLoreFacts": { "type": "array", "items": { "$ref": "#/$defs/factGate" } },
        "forbiddenSemanticAdditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "reviewStatus": { "enum": ["UNMAPPED", "CANDIDATE", "REVIEWED", "APPROVED", "BLOCKED"] },
        "readiness": { "$ref": "#/$defs/readiness" },
        "provenance": {
          "type": "object",
          "required": ["source", "schemaVersion"],
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "schemaVersion": { "const": "dpa-keyword-foundation@0.1" },
            "sourceAnchorIds": { "type": "array", "items": { "pattern": "^ANCHOR_(DEAL|PRESSURE|ASK)_[A-Z]{2}$" } },
            "transformVersion": { "type": "string", "minLength": 1 },
            "reviewNote": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "templateVariantId": { "pattern": "^TPL_TEMPLATE_(DEAL|PRESSURE|ASK)_[A-Z]{2}_(SUBTLE|BALANCED|OVERT)_CANONICAL_NEUTRAL_V01$" },
        "constructionId": { "pattern": "^CONSTRUCTION_[A-Z0-9_]+$" },
        "tplProtocolId": { "pattern": "^PROTOCOL_[A-Z0-9_]+$" },
        "styleProfileId": { "pattern": "^[A-Z0-9_]+$" },
        "sourceLine": { "type": ["integer", "null"], "minimum": 1 },
        "executionMode": { "enum": ["AUTHORING_PREVIEW", "PRODUCTION", "PRODUCTION_RUNTIME", "PRODUCTION_SAFETY_FALLBACK"] },
        "gateDisposition": { "enum": ["NEUTRAL_SAME_COORDINATE_REWRITE", "NO_CONTEXT_CLAIM", "LEGACY_PRODUCTION_SAFETY_PATH"] },
        "previewEligible": { "type": "boolean" },
        "productionEligible": { "type": "boolean" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            { "properties": { "readiness": { "properties": { "state": { "const": "PREVIEW_READY" } } }, "reviewStatus": { "const": "CANDIDATE" }, "executionMode": { "const": "AUTHORING_PREVIEW" }, "previewEligible": { "const": true }, "productionEligible": { "const": false } } },
            { "properties": { "readiness": { "properties": { "state": { "const": "REVIEWED" } } }, "reviewStatus": { "const": "REVIEWED" }, "executionMode": { "const": "AUTHORING_PREVIEW" }, "previewEligible": { "const": true }, "productionEligible": { "const": false } } },
            { "properties": { "readiness": { "properties": { "state": { "const": "APPROVED" } } }, "reviewStatus": { "const": "APPROVED" }, "executionMode": { "const": "AUTHORING_PREVIEW" }, "previewEligible": { "const": true }, "productionEligible": { "const": false } } },
            { "properties": { "readiness": { "properties": { "state": { "const": "PRODUCTION_ELIGIBLE" } } }, "reviewStatus": { "const": "APPROVED" }, "styleProfileId": { "const": "ZANT_HUMOR_V01" }, "executionMode": { "enum": ["PRODUCTION", "PRODUCTION_RUNTIME"] }, "previewEligible": { "const": true }, "productionEligible": { "const": true } } },
            { "properties": { "readiness": { "properties": { "state": { "const": "BLOCKED" } } }, "reviewStatus": { "const": "BLOCKED" }, "executionMode": { "enum": ["AUTHORING_PREVIEW", "PRODUCTION_SAFETY_FALLBACK"] }, "previewEligible": { "const": false }, "productionEligible": { "const": false } } }
          ]
        },
        {
          "oneOf": [
            { "properties": { "speechAct": { "const": "ASK" }, "actionInvariant": { "const": ["REQUEST"] }, "constructionId": { "const": "CONSTRUCTION_ASK_REQUEST" }, "tplProtocolId": { "const": "PROTOCOL_ASK_CANONICAL_NEUTRAL_V01" } } },
            { "properties": { "speechAct": { "const": "DEAL" }, "actionInvariant": { "const": ["OFFER", "RETURN"] }, "constructionId": { "const": "CONSTRUCTION_DEAL_EXCHANGE" }, "tplProtocolId": { "const": "PROTOCOL_DEAL_CANONICAL_NEUTRAL_V01" } } },
            { "properties": { "speechAct": { "const": "PRESSURE" }, "actionInvariant": { "const": ["DEMAND", "CONSEQUENCE"] }, "constructionId": { "const": "CONSTRUCTION_PRESSURE_CONSEQUENCE" }, "tplProtocolId": { "const": "PROTOCOL_PRESSURE_CANONICAL_NEUTRAL_V01" } } }
          ]
        }
      ]
    },
    "readiness": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": { "enum": ["PREVIEW_READY", "REVIEWED", "APPROVED", "PRODUCTION_ELIGIBLE", "BLOCKED"] }
      },
      "additionalProperties": false
    },
    "factGate": {
      "type": "object",
      "required": ["requiredFact", "reason", "sourceAnchorId"],
      "properties": {
        "requiredFact": { "enum": ["AUDIENCE_OR_PUBLIC_CONTEXT", "FRIENDSHIP_OR_RELATIONSHIP", "TIME_OR_DEADLINE", "SPEAKER_KNOWLEDGE_OR_PERSPECTIVE", "PROTECTION_OR_CARE", "LEVERAGE_OR_CONSEQUENCE", "NORM_OR_JUDGMENT", "POSSIBLE_ASK_TO_PRESSURE_DRIFT"] },
        "reason": { "type": "string", "minLength": 1 },
        "sourceAnchorId": { "pattern": "^ANCHOR_(DEAL|PRESSURE|ASK)_[A-Z]{2}$" }
      },
      "additionalProperties": false
    },
    "atom": {
      "type": "object",
      "required": ["atomId", "family", "subtype", "operation", "maxOccurrences", "status", "provenance"],
      "properties": {
        "atomId": { "pattern": "^ATOM_[A-Z0-9_]+$" },
        "family": { "enum": ["VOICE_QUALITY", "VOCALIZATION", "TACTILE_KINESIC", "VISUAL_KINESIC", "ARTIFACT"] },
        "subtype": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "maxOccurrences": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["UNMAPPED", "CANDIDATE", "REVIEWED", "APPROVED", "BLOCKED"] },
        "statusReason": { "type": "string", "minLength": 1 },
        "provenance": { "const": "PROJECT_AUTHORED" }
      },
      "additionalProperties": false
    },
    "construction": {
      "type": "object",
      "required": ["constructionId", "speechActs", "requiredSlots", "status", "provenance"],
      "properties": {
        "constructionId": { "pattern": "^CONSTRUCTION_[A-Z0-9_]+$" },
        "speechActs": { "type": "array", "minItems": 1, "items": { "enum": ["DEAL", "PRESSURE", "ASK"] } },
        "requiredSlots": { "type": "array", "minItems": 1, "items": { "enum": ["REQUEST", "OFFER", "RETURN", "DEMAND", "CONSEQUENCE"] } },
        "status": { "enum": ["UNMAPPED", "CANDIDATE", "REVIEWED", "APPROVED", "BLOCKED"] },
        "provenance": { "const": "PROJECT_AUTHORED" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            { "properties": { "constructionId": { "const": "CONSTRUCTION_ASK_REQUEST" }, "speechActs": { "const": ["ASK"] }, "requiredSlots": { "const": ["REQUEST"] } } },
            { "properties": { "constructionId": { "const": "CONSTRUCTION_DEAL_EXCHANGE" }, "speechActs": { "const": ["DEAL"] }, "requiredSlots": { "const": ["OFFER", "RETURN"] } } },
            { "properties": { "constructionId": { "const": "CONSTRUCTION_PRESSURE_CONSEQUENCE" }, "speechActs": { "const": ["PRESSURE"] }, "requiredSlots": { "const": ["DEMAND", "CONSEQUENCE"] } } }
          ]
        }
      ]
    },
    "protocol": {
      "type": "object",
      "required": ["tplProtocolId", "speechActs", "constructionIds", "requiredAtomIds", "optionalAtomIds", "excludedAtomIds", "intensityProfiles", "semanticInvarianceRequired", "reviewStatus", "readiness", "provenance"],
      "properties": {
        "tplProtocolId": { "pattern": "^PROTOCOL_[A-Z0-9_]+$" },
        "speechActs": { "type": "array", "minItems": 1, "items": { "enum": ["DEAL", "PRESSURE", "ASK"] } },
        "constructionIds": { "type": "array", "minItems": 1, "items": { "pattern": "^CONSTRUCTION_[A-Z0-9_]+$" } },
        "requiredAtomIds": { "type": "array", "items": { "pattern": "^ATOM_[A-Z0-9_]+$" } },
        "optionalAtomIds": { "type": "array", "items": { "pattern": "^ATOM_[A-Z0-9_]+$" } },
        "excludedAtomIds": { "type": "array", "items": { "pattern": "^ATOM_[A-Z0-9_]+$" } },
        "intensityProfiles": { "const": ["SUBTLE", "BALANCED", "OVERT"] },
        "semanticInvarianceRequired": { "const": true },
        "reviewStatus": { "enum": ["UNMAPPED", "CANDIDATE", "REVIEWED", "APPROVED", "BLOCKED"] },
        "readiness": { "$ref": "#/$defs/readiness" },
        "provenance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            { "properties": { "readiness": { "properties": { "state": { "const": "PREVIEW_READY" } } }, "reviewStatus": { "const": "CANDIDATE" } } },
            { "properties": { "readiness": { "properties": { "state": { "const": "REVIEWED" } } }, "reviewStatus": { "const": "REVIEWED" } } },
            { "properties": { "readiness": { "properties": { "state": { "const": "APPROVED" } } }, "reviewStatus": { "const": "APPROVED" } } },
            { "properties": { "readiness": { "properties": { "state": { "const": "PRODUCTION_ELIGIBLE" } } }, "reviewStatus": { "const": "APPROVED" } } },
            { "properties": { "readiness": { "properties": { "state": { "const": "BLOCKED" } } }, "reviewStatus": { "const": "BLOCKED" } } }
          ]
        },
        {
          "oneOf": [
            { "properties": { "tplProtocolId": { "const": "PROTOCOL_ASK_CANONICAL_NEUTRAL_V01" }, "speechActs": { "const": ["ASK"] }, "constructionIds": { "const": ["CONSTRUCTION_ASK_REQUEST"] } } },
            { "properties": { "tplProtocolId": { "const": "PROTOCOL_DEAL_CANONICAL_NEUTRAL_V01" }, "speechActs": { "const": ["DEAL"] }, "constructionIds": { "const": ["CONSTRUCTION_DEAL_EXCHANGE"] } } },
            { "properties": { "tplProtocolId": { "const": "PROTOCOL_PRESSURE_CANONICAL_NEUTRAL_V01" }, "speechActs": { "const": ["PRESSURE"] }, "constructionIds": { "const": ["CONSTRUCTION_PRESSURE_CONSEQUENCE"] } } }
          ]
        }
      ]
    },
    "template": {
      "type": "object",
      "required": ["templateVariantId", "coordinateKey", "speechAct", "vibeId", "deliveryIntensity", "constructionId", "tplProtocolId", "styleProfileId", "sourceLine", "gateDisposition", "candidateAnchorIds", "requiredContextOrLoreFacts", "reviewStatus", "readiness", "previewEligible", "productionEligible", "provenance"],
      "properties": {
        "templateVariantId": { "pattern": "^TPL_TEMPLATE_(DEAL|PRESSURE|ASK)_[A-Z]{2}_(SUBTLE|BALANCED|OVERT)_CANONICAL_NEUTRAL_V01$" },
        "coordinateKey": { "pattern": "^(DEAL|PRESSURE|ASK)_[A-Z]{2}_(SUBTLE|BALANCED|OVERT)$" },
        "speechAct": { "enum": ["DEAL", "PRESSURE", "ASK"] },
        "vibeId": { "pattern": "^[A-Z][A-Z]$" },
        "deliveryIntensity": { "enum": ["SUBTLE", "BALANCED", "OVERT"] },
        "constructionId": { "pattern": "^CONSTRUCTION_[A-Z0-9_]+$" },
        "tplProtocolId": { "pattern": "^PROTOCOL_[A-Z0-9_]+$" },
        "styleProfileId": { "const": "CANONICAL_NEUTRAL_V01" },
        "sourceLine": { "type": ["integer", "null"], "minimum": 1 },
        "gateDisposition": { "enum": ["NEUTRAL_SAME_COORDINATE_REWRITE", "NO_CONTEXT_CLAIM"] },
        "candidateAnchorIds": { "type": "array", "items": { "pattern": "^ANCHOR_(DEAL|PRESSURE|ASK)_[A-Z]{2}$" } },
        "requiredContextOrLoreFacts": { "type": "array", "items": { "$ref": "#/$defs/factGate" } },
        "reviewStatus": { "const": "REVIEWED" },
        "readiness": { "$ref": "#/$defs/readiness" },
        "previewEligible": { "const": true },
        "productionEligible": { "const": false },
        "provenance": { "$ref": "#/$defs/runtimeProvenance" }
      },
      "additionalProperties": false,
      "allOf": [
        { "properties": { "readiness": { "properties": { "state": { "const": "REVIEWED" } } } } }
      ]
    },
    "runtimeProvenance": {
      "type": "object",
      "required": ["source", "schemaVersion", "sourceAnchorIds", "transformVersion", "reviewNote"],
      "properties": {
        "source": { "const": "DERIVED_CANONICAL_NEUTRAL_V01" },
        "schemaVersion": { "const": "dpa-keyword-foundation@0.1" },
        "sourceAnchorIds": { "type": "array", "minItems": 1, "items": { "pattern": "^ANCHOR_(DEAL|PRESSURE|ASK)_[A-Z]{2}$" } },
        "transformVersion": { "type": "string", "minLength": 1 },
        "reviewNote": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "styleProfile": {
      "type": "object",
      "required": ["profileId", "version", "name", "reviewStatus", "readiness", "previewEligible", "productionEligible", "provenance", "description"],
      "properties": {
        "profileId": { "enum": ["CANONICAL_NEUTRAL_V01", "ZANT_HUMOR_V01"] },
        "version": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "reviewStatus": { "enum": ["UNMAPPED", "CANDIDATE", "REVIEWED", "APPROVED", "BLOCKED"] },
        "readiness": { "$ref": "#/$defs/readiness" },
        "previewEligible": { "type": "boolean" },
        "productionEligible": { "type": "boolean" },
        "provenance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            { "properties": { "profileId": { "const": "CANONICAL_NEUTRAL_V01" }, "readiness": { "properties": { "state": { "const": "REVIEWED" } } }, "reviewStatus": { "const": "REVIEWED" }, "previewEligible": { "const": true }, "productionEligible": { "const": false } } },
            { "properties": { "profileId": { "const": "ZANT_HUMOR_V01" }, "readiness": { "properties": { "state": { "const": "BLOCKED" } } }, "reviewStatus": { "const": "BLOCKED" }, "previewEligible": { "const": false }, "productionEligible": { "const": false } } }
          ]
        }
      ]
    },
    "faceBoundary": {
      "type": "object",
      "required": ["system", "relation", "reactionFaceField", "replyFaceField", "rendererMayMutateFaceSlots"],
      "properties": {
        "system": { "const": "SEPARATE_FACE_EVIDENCE" },
        "relation": { "const": "MANY_TO_MANY" },
        "reactionFaceField": { "const": "reactionFaceId" },
        "replyFaceField": { "const": "replyFaceId" },
        "rendererMayMutateFaceSlots": { "const": false }
      },
      "additionalProperties": false
    },
    "fallbackPolicy": {
      "type": "object",
      "required": ["status", "formsPerAct", "totalActIntensityForms", "vibeAffectsWording", "vibeAffects", "dynamicDialoguePopulation", "approvedProtocolCount", "productionBoundary", "legacyFallback"],
      "properties": {
        "status": { "const": "PHASE_2_AUTHORING_PREVIEW" },
        "formsPerAct": { "const": 3 },
        "totalActIntensityForms": { "const": 9 },
        "vibeAffectsWording": { "const": true },
        "vibeAffects": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "dynamicDialoguePopulation": { "const": "PHASE_2_AUTHORING_PREVIEW" },
        "approvedProtocolCount": { "const": 0 },
        "productionBoundary": { "const": "FAIL_CLOSED_UNTIL_OWNER_APPROVAL" },
        "legacyFallback": { "const": "EXPLICIT_PRODUCTION_SAFETY_PATH_ONLY" }
      },
      "additionalProperties": false
    }
  }
}
