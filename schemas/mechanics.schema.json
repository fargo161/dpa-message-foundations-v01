{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpa-message-foundations.invalid/schemas/mechanics.schema.json",
  "title": "DPA mechanics state, action, transition, trace, and capacity contracts",
  "oneOf": [
    { "$ref": "#/$defs/state" },
    { "$ref": "#/$defs/actionEvaluation" },
    { "$ref": "#/$defs/resolvedAction" },
    { "$ref": "#/$defs/capacity" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$" },
    "macroAct": { "type": "string", "enum": ["DEAL", "PRESSURE", "ASK"] },
    "scope": { "type": "string", "enum": ["ACTUAL", "BELIEF"] },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "actionPayloadBase": {
      "type": "object",
      "required": ["actor", "target", "action"],
      "properties": {
        "actor": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/id" },
        "action": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }
      }
    },
    "exchangePayload": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "object": { "$ref": "#/$defs/nonEmptyString" },
        "quantity": { "type": "number", "minimum": 0.000001 },
        "unit": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "$ref": "#/$defs/nonEmptyString" },
        "change": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "dealPayload": {
      "type": "object",
      "required": ["actor", "target", "action", "return"],
      "properties": {
        "actor": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/id" },
        "action": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "offer": { "$ref": "#/$defs/exchangePayload" },
        "information": { "$ref": "#/$defs/nonEmptyString" },
        "return": { "$ref": "#/$defs/exchangePayload" }
      },
      "anyOf": [
        { "required": ["offer"] },
        { "required": ["information"] }
      ],
      "additionalProperties": false
    },
    "linkedLeverage": {
      "type": "object",
      "required": ["actor", "target", "basis", "sourceAssertionId", "scope", "contextId", "validFrom", "pressureContractId"],
      "properties": {
        "actor": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/id" },
        "basis": { "$ref": "#/$defs/id" },
        "sourceAssertionId": { "$ref": "#/$defs/id" },
        "scope": { "$ref": "#/$defs/scope" },
        "contextId": { "$ref": "#/$defs/id" },
        "validFrom": { "type": "string", "format": "date-time" },
        "pressureContractId": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "linkedDemand": {
      "type": "object",
      "required": ["kind", "demandId", "subject", "object", "term", "amount", "unit", "due", "sourceAssertionId", "scope", "contextId", "validFrom", "pressureContractId", "authoredDemand"],
      "properties": {
        "kind": { "const": "FULFILL_OBLIGATION" },
        "demandId": { "$ref": "#/$defs/id" },
        "subject": { "$ref": "#/$defs/id" },
        "object": { "$ref": "#/$defs/id" },
        "term": { "$ref": "#/$defs/id" },
        "amount": { "type": "number", "minimum": 0.000001 },
        "unit": { "$ref": "#/$defs/nonEmptyString" },
        "due": { "type": "string", "format": "date-time" },
        "sourceAssertionId": { "$ref": "#/$defs/id" },
        "scope": { "$ref": "#/$defs/scope" },
        "contextId": { "$ref": "#/$defs/id" },
        "validFrom": { "type": "string", "format": "date-time" },
        "pressureContractId": { "$ref": "#/$defs/id" },
        "authoredDemand": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "linkedConsequence": {
      "type": "object",
      "required": ["consequenceId", "text", "fearedBy", "fearedConsequenceSourceAssertionId", "leverageBasis", "demandId", "scope", "contextId", "validFrom", "validity", "pressureContractId"],
      "properties": {
        "consequenceId": { "$ref": "#/$defs/id" },
        "text": { "$ref": "#/$defs/nonEmptyString" },
        "fearedBy": { "$ref": "#/$defs/id" },
        "fearedConsequenceSourceAssertionId": { "$ref": "#/$defs/id" },
        "leverageBasis": { "$ref": "#/$defs/id" },
        "demandId": { "$ref": "#/$defs/id" },
        "scope": { "$ref": "#/$defs/scope" },
        "contextId": { "$ref": "#/$defs/id" },
        "validFrom": { "type": "string", "format": "date-time" },
        "validity": {
          "type": "object",
          "required": ["scope", "contextId", "validFrom", "validUntilIsUnbounded"],
          "properties": {
            "scope": { "$ref": "#/$defs/scope" },
            "contextId": { "$ref": "#/$defs/id" },
            "validFrom": { "type": "string", "format": "date-time" },
            "validUntilIsUnbounded": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "pressureContractId": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "pressurePayload": {
      "type": "object",
      "required": ["actor", "target", "action", "contextId", "leverage", "demand", "consequence"],
      "properties": {
        "actor": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/id" },
        "action": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "contextId": { "$ref": "#/$defs/id" },
        "leverage": { "$ref": "#/$defs/linkedLeverage" },
        "demand": { "$ref": "#/$defs/linkedDemand" },
        "consequence": { "$ref": "#/$defs/linkedConsequence" }
      },
      "additionalProperties": false
    },
    "askPayload": {
      "type": "object",
      "required": ["actor", "target", "action"],
      "properties": {
        "actor": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/id" },
        "action": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "object": { "$ref": "#/$defs/nonEmptyString" },
        "permission": { "$ref": "#/$defs/nonEmptyString" },
        "information": { "$ref": "#/$defs/nonEmptyString" },
        "request": { "$ref": "#/$defs/nonEmptyString" }
      },
      "anyOf": [
        { "required": ["object"] },
        { "required": ["permission"] },
        { "required": ["information"] },
        { "required": ["request"] }
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["sourceId", "sourceVersion", "sourceRecordId", "transformVersion", "licenseId"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/id" },
        "sourceVersion": { "type": "string", "minLength": 1 },
        "sourceRecordId": { "$ref": "#/$defs/id" },
        "transformVersion": { "type": "string", "minLength": 1 },
        "licenseId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": ["id", "displayName", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["ACTOR", "RESOURCE", "OBJECT", "LOCATION", "ACTION", "PROPOSITION", "SECRET", "OBLIGATION"] }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["id", "name", "active"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "active": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": ["assertionId", "keywordId", "args", "scope", "polarity", "status", "contextIds", "validFrom", "validUntil", "provenance", "notes"],
      "properties": {
        "assertionId": { "$ref": "#/$defs/id" },
        "keywordId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "args": { "type": "object", "minProperties": 1 },
        "scope": { "$ref": "#/$defs/scope" },
        "polarity": { "type": "string", "enum": ["ASSERTED", "DENIED", "DISPUTED"] },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE", "PENDING", "FULFILLED", "BROKEN", "SUPERSEDED"] },
        "contextIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "validFrom": { "type": "string", "format": "date-time" },
        "validUntil": { "type": ["string", "null"], "format": "date-time" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "blocker": {
      "type": "object",
      "required": ["id", "reason"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "actionId": { "$ref": "#/$defs/id" },
        "actionIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "actor": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/id" },
        "contextId": { "$ref": "#/$defs/id" },
        "contextIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "scope": { "$ref": "#/$defs/scope" },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "validFrom": { "type": "string", "format": "date-time" },
        "validUntil": { "type": ["string", "null"], "format": "date-time" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "pressureContract": {
      "type": "object",
      "required": ["contractId", "actorId", "targetId", "contextId", "scope", "status", "validFrom", "validUntil", "leverageAssertionId", "obligationAssertionId", "fearAssertionId", "demand", "fearedConsequenceId", "consequenceId", "provenance"],
      "properties": {
        "contractId": { "$ref": "#/$defs/id" },
        "actorId": { "$ref": "#/$defs/id" },
        "targetId": { "$ref": "#/$defs/id" },
        "contextId": { "$ref": "#/$defs/id" },
        "scope": { "$ref": "#/$defs/scope" },
        "status": { "enum": ["ACTIVE", "INACTIVE"] },
        "validFrom": { "type": "string", "format": "date-time" },
        "validUntil": { "type": ["string", "null"], "format": "date-time" },
        "leverageAssertionId": { "$ref": "#/$defs/id" },
        "obligationAssertionId": { "$ref": "#/$defs/id" },
        "fearAssertionId": { "$ref": "#/$defs/id" },
        "demand": { "$ref": "#/$defs/nonEmptyString" },
        "fearedConsequenceId": { "$ref": "#/$defs/id" },
        "consequenceId": { "$ref": "#/$defs/id" },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },
    "historyEvent": {
      "type": "object",
      "required": ["historyId", "eventType", "actorId", "targetId", "actionId", "contextId", "createdAt", "provenance"],
      "properties": {
        "historyId": { "$ref": "#/$defs/id" },
        "eventType": { "$ref": "#/$defs/id" },
        "actorId": { "$ref": "#/$defs/id" },
        "targetId": { "$ref": "#/$defs/id" },
        "actionId": { "$ref": "#/$defs/id" },
        "contextId": { "$ref": "#/$defs/id" },
        "createdAt": { "type": "string", "format": "date-time" },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },
    "pair": {
      "type": "object",
      "required": ["actorId", "targetId", "contextId"],
      "properties": {
        "actorId": { "$ref": "#/$defs/id" },
        "targetId": { "$ref": "#/$defs/id" },
        "contextId": { "$ref": "#/$defs/id" },
        "reachable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": ["schemaVersion", "scenarioId", "title", "now", "entities", "contexts", "facts", "priors", "history", "consequences", "blockers", "pressureContracts", "recommendedPairs"],
      "properties": {
        "schemaVersion": { "const": "dpa-keyword-foundation@0.1" },
        "scenarioId": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "now": { "type": "string", "format": "date-time" },
        "entities": { "type": "object", "patternProperties": { "^[A-Za-z0-9][A-Za-z0-9_.:-]*$": { "$ref": "#/$defs/entity" } }, "additionalProperties": false },
        "contexts": { "type": "array", "items": { "$ref": "#/$defs/context" }, "uniqueItems": true },
        "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "priors": { "type": "array" },
        "history": { "type": "array", "items": { "$ref": "#/$defs/historyEvent" } },
        "consequences": { "type": "object", "additionalProperties": { "type": "string" } },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } },
        "pressureContracts": { "type": "array", "items": { "$ref": "#/$defs/pressureContract" } },
        "recommendedPairs": { "type": "array", "items": { "$ref": "#/$defs/pair" } }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["passed", "code", "message", "matchedFacts"],
      "properties": {
        "passed": { "type": "boolean" },
        "code": { "$ref": "#/$defs/id" },
        "message": { "type": "string" },
        "matchedFacts": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      },
      "additionalProperties": false
    },
    "traceStep": {
      "type": "object",
      "required": ["step"],
      "properties": {
        "step": { "$ref": "#/$defs/id" },
        "code": { "$ref": "#/$defs/id" },
        "passed": { "type": "boolean" },
        "status": { "type": "string" },
        "detail": { "type": "string" },
        "matchedFacts": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      },
      "additionalProperties": false
    },
    "actionEvaluation": {
      "type": "object",
      "required": ["actionId", "displayName", "macroAct", "actorId", "targetId", "contextId", "status", "requiredChecks", "forbiddenChecks", "blockers", "trace"],
      "properties": {
        "actionId": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string" },
        "macroAct": { "$ref": "#/$defs/macroAct" },
        "actorId": { "$ref": "#/$defs/id" },
        "targetId": { "$ref": "#/$defs/id" },
        "contextId": { "$ref": "#/$defs/id" },
        "status": { "type": "string", "enum": ["AVAILABLE", "BLOCKED"] },
        "requiredChecks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
        "forbiddenChecks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
        "consistencyChecks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/check" } },
        "trace": { "type": "array", "items": { "$ref": "#/$defs/traceStep" } }
      },
      "additionalProperties": false
    },
    "resolvedAction": {
      "allOf": [
        { "$ref": "#/$defs/resolvedActionBase" },
        {
          "oneOf": [
            { "$ref": "#/$defs/dealResolution" },
            { "$ref": "#/$defs/pressureResolution" },
            { "$ref": "#/$defs/askResolution" }
          ]
        }
      ]
    },
    "resolvedActionBase": {
      "type": "object",
      "required": ["actionId", "actorId", "targetId", "macroAct", "payload", "preconditionEvaluations", "outcome", "deterministicEffects", "emittedHistory", "mandatorySemanticFacts", "forbiddenSemanticAdditions", "quarantine", "trace", "stateBefore", "stateAfter"],
      "properties": {
        "actionId": { "$ref": "#/$defs/id" },
        "actorId": { "$ref": "#/$defs/id" },
        "targetId": { "$ref": "#/$defs/id" },
        "macroAct": { "$ref": "#/$defs/macroAct" },
        "resolutionRecordId": { "type": ["string", "null"], "minLength": 1 },
        "payload": { "type": ["object", "null"] },
        "preconditionEvaluations": { "type": "object", "required": ["required", "forbidden"], "properties": { "required": { "type": "array" }, "forbidden": { "type": "array" } }, "additionalProperties": false },
        "outcome": { "type": "string", "enum": ["PROPOSED", "BLOCKED"] },
        "deterministicEffects": { "type": "array" },
        "emittedHistory": { "type": "array", "items": { "$ref": "#/$defs/historyEvent" } },
        "mandatorySemanticFacts": { "type": "array", "items": { "type": "string" } },
        "forbiddenSemanticAdditions": { "type": "array", "items": { "type": "string" } },
        "quarantine": { "type": ["object", "null"] },
        "trace": { "type": "array", "items": { "$ref": "#/$defs/traceStep" } },
        "stateBefore": { "$ref": "#/$defs/state" },
        "stateAfter": { "$ref": "#/$defs/state" }
      },
      "additionalProperties": false
    },
    "dealResolution": {
      "type": "object",
      "properties": {
        "macroAct": { "const": "DEAL" },
        "payload": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/dealPayload" }] }
      }
    },
    "pressureResolution": {
      "type": "object",
      "properties": {
        "macroAct": { "const": "PRESSURE" },
        "payload": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/pressurePayload" }] }
      }
    },
    "askResolution": {
      "type": "object",
      "properties": {
        "macroAct": { "const": "ASK" },
        "payload": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/askPayload" }] }
      }
    },
    "configuration": {
      "type": "object",
      "required": ["scenarioId", "actorId", "targetId", "actionId", "macroAct", "coordinateKey"],
      "properties": {
        "scenarioId": { "$ref": "#/$defs/id" },
        "actorId": { "$ref": "#/$defs/id" },
        "targetId": { "$ref": "#/$defs/id" },
        "actionId": { "$ref": "#/$defs/id" },
        "macroAct": { "$ref": "#/$defs/macroAct" },
        "coordinateKey": { "type": "string", "pattern": "^(DEAL|PRESSURE|ASK)_[A-Z]{2}_(SUBTLE|BALANCED|OVERT)$" }
      },
      "additionalProperties": false
    },
    "capacity": {
      "type": "object",
      "required": ["theoretical", "actCompatibleTheoretical", "totalCandidateCombinations", "actIncompatible", "blocked", "duplicate", "unreachable", "validUnique", "candidatePairs", "blockedCandidates", "duplicateCandidates", "validUniqueSemanticConfigurations", "validConfigurations", "classificationTotals", "notes"],
      "properties": {
        "theoretical": { "type": "integer", "minimum": 0 },
        "actCompatibleTheoretical": { "type": "integer", "minimum": 0 },
        "totalCandidateCombinations": { "type": "integer", "minimum": 0 },
        "actIncompatible": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "duplicate": { "type": "integer", "minimum": 0 },
        "unreachable": { "type": "integer", "minimum": 0 },
        "validUnique": { "type": "integer", "minimum": 0 },
        "candidatePairs": { "type": "integer", "minimum": 0 },
        "blockedCandidates": { "type": "integer", "minimum": 0 },
        "duplicateCandidates": { "type": "integer", "minimum": 0 },
        "validUniqueSemanticConfigurations": { "type": "integer", "minimum": 0 },
        "validConfigurations": { "type": "array", "items": { "$ref": "#/$defs/configuration" } },
        "classificationTotals": { "type": "object", "required": ["theoretical", "actIncompatible", "blocked", "duplicate", "unreachable", "validUnique"], "additionalProperties": { "type": "integer", "minimum": 0 } },
        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
