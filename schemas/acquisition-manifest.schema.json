{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpa-message-foundations.invalid/schemas/acquisition-manifest.schema.json",
  "title": "DPA real acquisition receipt manifest",
  "type": "object",
  "required": ["generatedAt", "sources"],
  "properties": {
    "generatedAt": { "type": "string", "format": "date-time" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
  },
  "additionalProperties": false,
  "$defs": {
    "counts": {
      "type": "object",
      "required": ["raw", "accepted", "rejected", "duplicate", "aggregatedAnnotationRows", "normalized", "indexed"],
      "properties": {
        "raw": { "type": "integer", "minimum": 0 },
        "accepted": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "duplicate": { "type": "integer", "minimum": 0 },
        "aggregatedAnnotationRows": { "type": "integer", "minimum": 0 },
        "normalized": { "type": "integer", "minimum": 0 },
        "indexed": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "zeroCounts": {
      "type": "object",
      "required": ["raw", "accepted", "rejected", "duplicate", "aggregatedAnnotationRows", "normalized", "indexed"],
      "properties": {
        "raw": { "const": 0 },
        "accepted": { "const": 0 },
        "rejected": { "const": 0 },
        "duplicate": { "const": 0 },
        "aggregatedAnnotationRows": { "const": 0 },
        "normalized": { "const": 0 },
        "indexed": { "const": 0 }
      },
      "additionalProperties": false
    },
    "extraction": {
      "oneOf": [
        {
          "type": "object",
          "required": ["sourceArchive", "extractedPath"],
          "properties": {
            "sourceArchive": { "const": false },
            "extractedPath": { "const": null },
            "extractedFileCount": { "type": "integer", "minimum": 0 },
            "extractedFiles": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["sourceArchive", "extractedPath", "extractedFileCount", "extractedFiles"],
          "properties": {
            "sourceArchive": { "const": true },
            "extractedPath": { "type": "string", "pattern": "^(?:\\.cache|data)/[^\\\\]+(?:/[^\\\\]+)*$" },
            "extractedFileCount": { "type": "integer", "minimum": 0 },
            "extractedFiles": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
          },
          "additionalProperties": false
        }
      ]
    },
    "indexSnapshot": {
      "type": "object",
      "required": ["indexVersion", "sourceId", "sourceVersion", "licenseId", "compactIndex", "recordCount", "tokenCount", "sourceIds", "persistedPostingsPath", "persistedTokenCount"],
      "properties": {
        "indexVersion": { "type": "string", "minLength": 1 },
        "sourceId": { "type": "string", "minLength": 1 },
        "sourceVersion": { "type": "string", "minLength": 1 },
        "licenseId": { "type": "string", "minLength": 1 },
        "compactIndex": { "type": "boolean" },
        "recordCount": { "type": "integer", "minimum": 0 },
        "tokenCount": { "type": "integer", "minimum": 0 },
        "sourceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "persistedPostingsPath": { "type": "string", "minLength": 1, "pattern": "^(?:\\.cache|data)/[^\\\\]+(?:/[^\\\\]+)*$" },
        "persistedTokenCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "probeResult": {
      "type": "object",
      "required": ["recordId", "sourceId", "sourceRecordId", "score", "matchedTokens", "provenance", "preview"],
      "properties": {
        "recordId": { "type": "string", "minLength": 1 },
        "sourceId": { "type": "string", "minLength": 1 },
        "sourceRecordId": { "type": "string", "minLength": 1 },
        "score": { "type": "number", "minimum": 0 },
        "matchedTokens": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "provenance": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "preview": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "probe": {
      "type": "object",
      "required": ["query", "results"],
      "properties": {
        "query": { "type": "string", "minLength": 1 },
        "results": { "type": "array", "items": { "$ref": "#/$defs/probeResult" } }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["sourceId", "status", "sourceVersion", "licenseId", "canonicalUrl", "redistributionPolicy", "counts", "duplicateRecordIds", "rejections", "probes", "evidenceBoundary"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["ACQUIRED_AND_INDEXED", "ACQUIRED_NOT_INDEXED", "FIXTURE_ONLY", "MANIFEST_ONLY", "BLOCKED", "EXCLUDED"] },
        "sourceVersion": { "type": "string", "minLength": 1 },
        "licenseId": { "type": "string", "minLength": 1 },
        "redistributionPolicy": { "type": "string", "minLength": 1 },
        "canonicalUrl": { "type": "string", "minLength": 1 },
        "artifactUrl": { "type": ["string", "null"] },
        "artifactFilename": { "type": ["string", "null"] },
        "artifactCachePath": { "type": ["string", "null"], "pattern": "^(?:\\.cache|data)/[^\\\\]+(?:/[^\\\\]+)*$" },
        "retrievedAt": { "type": ["string", "null"] },
        "byteSize": { "type": ["integer", "null"] },
        "sha256": { "type": ["string", "null"] },
        "receiptPath": { "type": ["string", "null"], "pattern": "^(?:\\.cache|data)/[^\\\\]+(?:/[^\\\\]+)*$" },
        "extraction": { "oneOf": [{ "$ref": "#/$defs/extraction" }, { "const": null }] },
        "observedSchema": { "type": "object", "additionalProperties": true },
        "counts": { "$ref": "#/$defs/counts" },
        "duplicateRecordIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "rejections": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "indexSnapshot": { "oneOf": [{ "$ref": "#/$defs/indexSnapshot" }, { "const": null }] },
        "probes": { "type": "array", "items": { "$ref": "#/$defs/probe" } },
        "normalizedRecordsPath": { "type": ["string", "null"], "pattern": "^(?:\\.cache|data)/[^\\\\]+(?:/[^\\\\]+)*$" },
        "evidenceBoundary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "status": { "const": "ACQUIRED_AND_INDEXED" },
                "artifactUrl": { "type": "string", "minLength": 1 },
                "artifactFilename": { "type": "string", "minLength": 1 },
                "artifactCachePath": { "type": "string", "minLength": 1, "pattern": "^(?:\\.cache|data)/[^\\\\]+(?:/[^\\\\]+)*$" },
                "retrievedAt": { "type": "string", "format": "date-time" },
                "byteSize": { "type": "integer", "minimum": 1 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "receiptPath": { "type": "string", "minLength": 1, "pattern": "^(?:\\.cache|data)/[^\\\\]+(?:/[^\\\\]+)*$" },
                "observedSchema": { "type": "object", "minProperties": 1 },
                "extraction": { "$ref": "#/$defs/extraction" },
                "counts": { "allOf": [{ "$ref": "#/$defs/counts" }, { "properties": { "raw": { "minimum": 1 }, "accepted": { "minimum": 1 }, "normalized": { "minimum": 1 }, "indexed": { "minimum": 1 } } }] },
                "indexSnapshot": { "allOf": [{ "$ref": "#/$defs/indexSnapshot" }, { "properties": { "recordCount": { "minimum": 1 }, "tokenCount": { "minimum": 1 }, "persistedTokenCount": { "minimum": 1 } } }] },
                "normalizedRecordsPath": { "type": "string", "minLength": 1, "pattern": "^(?:\\.cache|data)/[^\\\\]+(?:/[^\\\\]+)*$" },
                "probes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/probe" } }
              },
              "required": ["artifactUrl", "artifactFilename", "artifactCachePath", "retrievedAt", "byteSize", "sha256", "receiptPath", "observedSchema", "extraction", "indexSnapshot", "normalizedRecordsPath", "probes"]
            },
            {
              "properties": {
                "status": { "const": "ACQUIRED_NOT_INDEXED" },
                "artifactUrl": { "type": "string", "minLength": 1 },
                "artifactFilename": { "type": "string", "minLength": 1 },
                "artifactCachePath": { "type": "string", "minLength": 1, "pattern": "^(?:\\.cache|data)/[^\\\\]+(?:/[^\\\\]+)*$" },
                "retrievedAt": { "type": "string", "format": "date-time" },
                "byteSize": { "type": "integer", "minimum": 1 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "receiptPath": { "type": "string", "minLength": 1, "pattern": "^(?:\\.cache|data)/[^\\\\]+(?:/[^\\\\]+)*$" },
                "observedSchema": { "type": "object", "minProperties": 1 },
                "counts": { "properties": { "normalized": { "const": 0 }, "indexed": { "const": 0 } } },
                "extraction": { "oneOf": [{ "$ref": "#/$defs/extraction" }, { "const": null }] },
                "indexSnapshot": { "const": null },
                "normalizedRecordsPath": { "const": null },
                "probes": { "const": [] }
              },
              "required": ["artifactUrl", "artifactFilename", "artifactCachePath", "retrievedAt", "byteSize", "sha256", "receiptPath", "observedSchema", "extraction", "indexSnapshot", "normalizedRecordsPath", "probes"]
            },
            {
              "properties": {
                "status": { "enum": ["FIXTURE_ONLY", "MANIFEST_ONLY", "BLOCKED", "EXCLUDED"] },
                "counts": { "$ref": "#/$defs/zeroCounts" },
                "observedSchema": { "type": "object", "maxProperties": 0 },
                "artifactUrl": { "const": null },
                "artifactFilename": { "const": null },
                "artifactCachePath": { "const": null },
                "retrievedAt": { "const": null },
                "byteSize": { "const": null },
                "sha256": { "const": null },
                "receiptPath": { "const": null },
                "extraction": { "const": null },
                "indexSnapshot": { "const": null },
                "normalizedRecordsPath": { "const": null },
                "probes": { "const": [] }
              }
            }
          ]
        }
      ]
    }
  }
}
