{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpa-message-foundations.invalid/schemas/keyword.schema.json",
  "title": "DPA semantic keyword definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "keywordId", "displayName", "definition", "explicitNonMeanings", "category", "arity",
    "typedArgumentRoles", "argumentKeys", "optionalArgumentKeys", "directionality", "symmetry", "reciprocity",
    "inverseOrReciprocalRule", "allowedEntityAndResourceTypes", "temporalityAndHistoryBehavior", "temporalValidity",
    "negationDisputeAndBeliefHandling", "truthAndKnowledge", "requiredAndForbiddenContexts", "relatedStats",
    "compatibleKeywords", "conflictingKeywords", "contradictionPolicy", "possibleAffordances", "blockersAndDefeaters",
    "blockerPolicy", "possibleHistoryEmissions", "sourceAndProjectProvenance", "provenancePolicy", "positiveExamples",
    "boundaryExamples", "counterexamples", "reviewStatus"
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "upperId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
    "lowerId": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
    "stringList": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "sourceVersion", "sourceRecordId", "transformVersion", "licenseId"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/nonEmptyString" },
        "sourceVersion": { "$ref": "#/$defs/nonEmptyString" },
        "sourceRecordId": { "$ref": "#/$defs/nonEmptyString" },
        "transformVersion": { "$ref": "#/$defs/nonEmptyString" },
        "licenseId": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": "dpa-keyword-foundation@0.1" },
    "keywordId": { "$ref": "#/$defs/upperId" },
    "displayName": { "$ref": "#/$defs/nonEmptyString" },
    "definition": { "$ref": "#/$defs/nonEmptyString" },
    "explicitNonMeanings": { "$ref": "#/$defs/stringList", "minItems": 1 },
    "category": { "enum": ["MATERIAL", "OBLIGATION", "ACCESS", "DEPENDENCE", "KNOWLEDGE", "BELIEF", "EMOTION", "LEVERAGE"] },
    "arity": { "type": "integer", "minimum": 2, "maximum": 3 },
    "typedArgumentRoles": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 3,
      "propertyNames": { "enum": ["subject", "object", "term", "proposition", "secret", "basis"] },
      "additionalProperties": { "$ref": "#/$defs/upperId" }
    },
    "argumentKeys": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["subject", "object", "term", "proposition", "secret", "basis"] }
    },
    "optionalArgumentKeys": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "directionality": { "enum": ["DIRECTED", "UNDIRECTED"] },
    "symmetry": { "enum": ["ASYMMETRIC", "SYMMETRIC"] },
    "reciprocity": { "enum": ["NOT_IMPLIED", "MUTUAL_BY_DEFINITION"] },
    "inverseOrReciprocalRule": { "$ref": "#/$defs/nonEmptyString" },
    "allowedEntityAndResourceTypes": { "$ref": "#/$defs/stringList", "minItems": 1 },
    "temporalityAndHistoryBehavior": { "$ref": "#/$defs/nonEmptyString" },
    "temporalValidity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validFrom", "validUntil", "requiresActiveStatus", "historyMode"],
      "properties": {
        "validFrom": { "const": "INCLUSIVE" },
        "validUntil": { "const": "EXCLUSIVE_OR_NULL" },
        "requiresActiveStatus": { "const": true },
        "historyMode": { "const": "APPEND_ONLY" }
      }
    },
    "negationDisputeAndBeliefHandling": { "$ref": "#/$defs/nonEmptyString" },
    "truthAndKnowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultAssertionScope", "allowedAssertionScopes", "knowledgeBoundary"],
      "properties": {
        "defaultAssertionScope": { "enum": ["ACTUAL", "BELIEF", "KNOWLEDGE", "DISPUTED", "HYPOTHETICAL"] },
        "allowedAssertionScopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["ACTUAL", "BELIEF", "KNOWLEDGE", "DISPUTED", "HYPOTHETICAL"] }
        },
        "knowledgeBoundary": { "enum": ["NONE", "SUBJECT_SCOPED", "PROPOSITION_SCOPED"] }
      }
    },
    "requiredAndForbiddenContexts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "forbidden"],
      "properties": {
        "required": { "$ref": "#/$defs/stringList" },
        "forbidden": { "$ref": "#/$defs/stringList" }
      }
    },
    "relatedStats": { "$ref": "#/$defs/stringList" },
    "compatibleKeywords": { "$ref": "#/$defs/stringList" },
    "conflictingKeywords": { "$ref": "#/$defs/stringList" },
    "contradictionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "sameCanonicalBindings", "overlappingActiveTime", "resolution"],
      "properties": {
        "mode": { "enum": ["NONE", "PAIRWISE_CONFLICT", "TENSION"] },
        "sameCanonicalBindings": { "const": true },
        "overlappingActiveTime": { "const": true },
        "resolution": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "possibleAffordances": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DEAL", "PRESSURE", "ASK"],
      "properties": {
        "DEAL": { "$ref": "#/$defs/stringList" },
        "PRESSURE": { "$ref": "#/$defs/stringList" },
        "ASK": { "$ref": "#/$defs/stringList" }
      }
    },
    "blockersAndDefeaters": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/lowerId" }
    },
    "blockerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockerIds", "requiresAuthoredEvidence", "effect", "checkedBeforeAvailability"],
      "properties": {
        "blockerIds": { "$ref": "#/$defs/stringList" },
        "requiresAuthoredEvidence": { "const": true },
        "effect": { "const": "BLOCK_OR_DEFEAT" },
        "checkedBeforeAvailability": { "const": true }
      }
    },
    "possibleHistoryEmissions": { "$ref": "#/$defs/stringList" },
    "sourceAndProjectProvenance": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/provenance" }
    },
    "provenancePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredFields", "evidenceClass", "runtimeEligible"],
      "properties": {
        "requiredFields": {
          "type": "array",
          "const": ["sourceId", "sourceVersion", "sourceRecordId", "transformVersion", "licenseId"]
        },
        "evidenceClass": { "const": "PROJECT_AUTHORED" },
        "runtimeEligible": { "const": false }
      }
    },
    "positiveExamples": { "$ref": "#/$defs/stringList", "minItems": 1 },
    "boundaryExamples": { "$ref": "#/$defs/stringList", "minItems": 1 },
    "counterexamples": { "$ref": "#/$defs/stringList", "minItems": 1 },
    "reviewStatus": { "const": "APPROVED" }
  }
}
