{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "types": ["node"],
    "maxNodeModuleJsDepth": 0,
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.mjs", "scripts/**/*.mjs"],
  "exclude": ["node_modules"]
}
